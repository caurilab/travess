{
  "name": "travess-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "main": "dist/main.js",
  "description": "Coquille desktop Electron de Travess — réutilise le bundle web (principe n°8).",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "dev": "tsc -p . && TRAVESS_DESKTOP_DEV=1 electron .",
    "start": "tsc -p . && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "typescript": "^5.7.2"
  }
}
