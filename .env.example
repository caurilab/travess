# ── Travess — variables d'environnement (exemple) ──
# Copier en .env et renseigner. NE JAMAIS committer .env.

# App
APP_NAME=Travess
APP_ENV=local
APP_KEY=
APP_URL=http://travess.test

# Base de données (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=travess
DB_USERNAME=travess
DB_PASSWORD=

# Redis / queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=redis

# Stockage objet (documents)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=

# JSONCargo (tracking) — CONFIRMER HTTPS avant usage
JSONCARGO_BASE_URL=https://api.jsoncargo.com/api/v1/
JSONCARGO_API_KEY=
JSONCARGO_QUOTA_ALERT_PCT=75
JSONCARGO_QUOTA_CUTOFF_PCT=90

# IA (vision / extraction) — via Laravel AI SDK
AI_PROVIDER=
AI_API_KEY=

# Mobile Money (agrégateur agréé)
MOMO_AGREGATEUR=
MOMO_API_KEY=
MOMO_WEBHOOK_SECRET=

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# IMAP (fallback / passerelle armateur) — identifiants par tenant en base (chiffrés)
