APP_NAME=Travess
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=travess
DB_USERNAME=travess
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Auth — expiration des jetons Sanctum en minutes (défaut : 1 jour).
SANCTUM_EXPIRATION=1440

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Ingestion documentaire par IA (Lot 5).
# Driver « factice » (défaut) : déterministe, sans réseau ni clé — dev et tests.
# Driver « laravel_ai » : Claude via laravel/ai. La clé vit UNIQUEMENT ici, dans
# le .env local (jamais committée, jamais journalisée).
IA_DRIVER=factice
# Passer IA_DRIVER=laravel_ai pour activer l'extraction réelle.
# AI_PROVIDER = un fournisseur défini dans laravel/ai (voir liste ci-dessous).
# AI_MODEL   = l'identifiant de modèle chez ce fournisseur.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
# IA_DISQUE hérite de FILESYSTEM_DISK si absent.
#
# --- Tester différents LLM en local (multi-modèles) --------------------------
# 1) IA_DRIVER=laravel_ai   2) AI_PROVIDER + AI_MODEL   3) la clé du fournisseur.
# Puis : php artisan config:clear  &&  php artisan queue:work (le worker traite
# l'extraction en file ; sans worker, elle reste « en cours »).
# Fournisseurs disponibles (laravel/ai) et leur variable de clé :
#   anthropic  → ANTHROPIC_API_KEY  (ex. AI_MODEL=claude-opus-4-8 / claude-sonnet-4-5)
#   openai     → OPENAI_API_KEY     (ex. AI_MODEL=gpt-4o / gpt-4.1 / o4-mini)
#   gemini     → GEMINI_API_KEY     (ex. AI_MODEL=gemini-2.5-pro / gemini-2.0-flash)
#   mistral    → MISTRAL_API_KEY    (ex. AI_MODEL=mistral-large-latest)
#   groq       → GROQ_API_KEY       (ex. AI_MODEL=llama-3.3-70b-versatile)
#   deepseek   → DEEPSEEK_API_KEY   (ex. AI_MODEL=deepseek-chat)
# Renseigner UNIQUEMENT la clé du fournisseur choisi ; les autres restent vides.
# La clé vit UNIQUEMENT ici (jamais committée, jamais journalisée, jamais collée
# dans le chat). Pour personnaliser les fournisseurs : php artisan vendor:publish
# --tag=ai-config (crée config/ai.php).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Tracking conteneur (Lot G1). « factice » (défaut) : déterministe, sans clé.
# « jsoncargo » (à venir) : fournisseur réel. La clé mutualisée vit UNIQUEMENT
# ici. ⚠️ Confirmer la base URL en HTTPS avant d'envoyer la clé (doc en HTTP).
TRACKING_DRIVER=factice
JSONCARGO_BASE_URL=
JSONCARGO_API_KEY=

# Messagerie sortante (onboarding portail). « factice » (défaut) : sans réseau.
# « reel » : e-mail via le mailer Laravel (configurer MAIL_* + SPF/DKIM/DMARC
# sur travess.ci) ; WhatsApp/SMS restent différés tant que les fournisseurs
# agréés ne sont pas intégrés.
MESSAGERIE_DRIVER=factice

VITE_APP_NAME="${APP_NAME}"
